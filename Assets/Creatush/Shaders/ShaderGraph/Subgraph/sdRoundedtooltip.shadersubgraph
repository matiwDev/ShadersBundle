    "m_FunctionSource": "",
    "m_FunctionBody": "    // Constants\n    float pi = 3.14159265359;\n\n    // Scale the UV to match the polygon size\n    float2 scaledUV = uv / size;\n\n    // Angle and segment size\n    float angle = atan2(scaledUV.x, scaledUV.y); // Angle to UV\n    float r = 2.0 * pi / sides;                 // Segment angle size\n\n    // Closest distance to a polygon edge\n    float distance = cos(floor(0.5 + angle / r) * r - angle) * length(scaledUV);\n\n    Out = distance * size.x; // Scale back to size\n"
}

